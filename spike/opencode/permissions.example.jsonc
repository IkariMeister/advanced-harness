{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  // Fail closed for the server session. Agent exceptions below are deliberately narrow.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" },
  ],
  "agents": {
    "lead": { "mode": "primary", "permissions": [
      { "action": "subagent", "resource": "researcher", "effect": "allow" },
      { "action": "subagent", "resource": "planner", "effect": "allow" },
      { "action": "subagent", "resource": "implementer", "effect": "allow" },
      { "action": "subagent", "resource": "reviewer", "effect": "allow" },
      { "action": "subagent", "resource": "qa", "effect": "allow" },
      { "action": "harness_demo_status", "resource": "*", "effect": "allow" },
    ] },
    "operator": { "mode": "subagent", "permissions": [
      { "action": "harness_demo_status", "resource": "*", "effect": "allow" },
    ] },
    "external": { "mode": "subagent", "permissions": [
      { "action": "harness_demo_status", "resource": "*", "effect": "allow" },
    ] },
    "researcher": { "mode": "subagent", "permissions": [
      { "action": "read", "resource": "*", "effect": "allow" },
      { "action": "glob", "resource": "*", "effect": "allow" },
      { "action": "grep", "resource": "*", "effect": "allow" },
      { "action": "harness_demo_status", "resource": "*", "effect": "allow" },
    ] },
    "planner": { "mode": "subagent", "permissions": [
      { "action": "read", "resource": "*", "effect": "allow" },
      { "action": "glob", "resource": "*", "effect": "allow" },
      { "action": "grep", "resource": "*", "effect": "allow" },
      { "action": "harness_demo_status", "resource": "*", "effect": "allow" },
      { "action": "harness_demo_propose", "resource": "*", "effect": "allow" },
    ] },
    "implementer": { "mode": "subagent", "permissions": [
      { "action": "harness_demo_status", "resource": "*", "effect": "allow" },
      { "action": "harness_demo_apply", "resource": "*", "effect": "allow" },
    ] },
    "reviewer": { "mode": "subagent", "permissions": [
      { "action": "read", "resource": "*", "effect": "allow" },
      { "action": "glob", "resource": "*", "effect": "allow" },
      { "action": "grep", "resource": "*", "effect": "allow" },
      { "action": "harness_demo_status", "resource": "*", "effect": "allow" },
    ] },
    "qa": { "mode": "subagent", "permissions": [
      { "action": "harness_demo_status", "resource": "*", "effect": "allow" },
    ] },
  },
}
