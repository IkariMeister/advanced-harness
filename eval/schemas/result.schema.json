{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advanced-harness.local/eval/schemas/result.schema.json",
  "title": "EDD v1 Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "scenarioId",
    "scenarioVersion",
    "outcome",
    "reason",
    "durationMs",
    "observableStateChecks",
    "evidence",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": { "type": "string", "minLength": 1 },
    "scenarioId": {
      "type": "string",
      "pattern": "^EDD-(DEV|VAL)-[0-9]{3,}$"
    },
    "scenarioVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "outcome": {
      "type": "string",
      "enum": ["pass", "fail", "skipped", "inconclusive", "infrastructure_error"]
    },
    "reason": { "type": "string", "minLength": 1 },
    "durationMs": { "type": "number", "minimum": 0 },
    "observableStateChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion", "passed", "observed"],
        "properties": {
          "assertion": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "observed": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "check", "execution", "artifacts"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "category"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "category": {
                "type": "string",
                "enum": ["unit-tests", "static-analysis", "build", "e2e", "custom"]
              }
            }
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exitStatus", "durationMs", "basis"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "exitStatus": { "type": "integer" },
              "durationMs": { "type": "number", "minimum": 0 },
              "basis": {
                "type": "string",
                "enum": ["re-run", "judged from evidence only"]
              }
            }
          },
          "artifacts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoffCount",
        "roleTransitions",
        "skillsInvoked",
        "humanInterventions",
        "permissionAmbiguities",
        "reviewDetectedDefects",
        "escapedDefects"
      ],
      "properties": {
        "handoffCount": { "type": "integer", "minimum": 0 },
        "roleTransitions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "skillsInvoked": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "humanInterventions": { "type": "integer", "minimum": 0 },
        "permissionAmbiguities": { "type": "integer", "minimum": 0 },
        "reviewDetectedDefects": { "type": "integer", "minimum": 0 },
        "escapedDefects": { "type": "integer", "minimum": 0 },
        "tokenCostUsd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
