{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advanced-harness.local/eval/schemas/run-record.schema.json",
  "title": "EDD v1 / BH-051 Evaluation Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "protocolVersion",
    "recordKind",
    "repository",
    "runner",
    "hostEnvironment",
    "modelVerification",
    "taskClassification",
    "runManifest",
    "repeatability",
    "results",
    "metricObservation",
    "supplementaryMetrics",
    "limitations",
    "waivers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordId": { "type": "string", "pattern": "\\S" },
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "recordKind": {
      "type": "string",
      "enum": ["baseline", "candidate", "template"]
    },
    "baselineRef": { "type": "string", "pattern": "\\S" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "harnessVersion", "dirty"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "harnessVersion": { "type": "string", "pattern": "\\S" },
        "dirty": { "type": "boolean" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executedBy", "executionKind"],
      "properties": {
        "executedBy": { "type": "string", "pattern": "\\S" },
        "executionKind": {
          "type": "string",
          "enum": ["human-interactive", "agent-assisted", "ci-automated"]
        },
        "authorizedBy": { "type": "string", "pattern": "\\S" },
        "ciRunRef": { "type": "string", "pattern": "\\S" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "executionKind": { "const": "agent-assisted" } },
            "required": ["executionKind"]
          },
          "then": { "required": ["authorizedBy"] }
        }
      ]
    },
    "hostEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "hostVersion", "os", "networkEnforcement", "hermetic"],
      "properties": {
        "host": {
          "type": "string",
          "enum": ["opencode", "claude-code", "antigravity", "codex", "cursor"]
        },
        "hostVersion": { "type": "string", "pattern": "\\S" },
        "os": { "type": "string", "pattern": "\\S" },
        "networkEnforcement": {
          "type": "string",
          "enum": ["netns", "none", "not-applicable"]
        },
        "hermetic": { "type": "boolean" },
        "notes": { "type": "string", "pattern": "\\S" }
      }
    },
    "modelVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["loopback-fixture", "verified", "unverified"]
        },
        "evidence": { "type": "string", "pattern": "\\S" },
        "observedRoleModels": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "\\S" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "unverified" } },
            "required": ["status"]
          },
          "then": {
            "not": { "required": ["observedRoleModels"] }
          }
        }
      ]
    },
    "hostCapabilityPrerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrixSource",
        "sameRoleApprovalTransition",
        "localRemoteIsolation",
        "perRoleCommands",
        "skillsMcpExposure",
        "actualModelRouting"
      ],
      "properties": {
        "matrixSource": { "type": "string", "pattern": "\\S" },
        "sameRoleApprovalTransition": { "$ref": "#/$defs/capabilityStatus" },
        "localRemoteIsolation": { "$ref": "#/$defs/capabilityStatus" },
        "perRoleCommands": { "$ref": "#/$defs/capabilityStatus" },
        "skillsMcpExposure": { "$ref": "#/$defs/capabilityStatus" },
        "actualModelRouting": { "$ref": "#/$defs/capabilityStatus" }
      }
    },
    "taskClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskClasses", "taskCriteria"],
      "properties": {
        "taskClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "routine-implementation",
              "research-then-implementation",
              "architecture",
              "qa-visual",
              "local-external-operations"
            ]
          }
        },
        "taskCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "methodologyMode": {
          "type": "string",
          "enum": ["RDD", "SDD", "ODD", "HYBRID", "unspecified"]
        },
        "rigor": {
          "type": "string",
          "enum": ["minimal", "standard", "strict", "unspecified"]
        }
      }
    },
    "runManifest": {
      "$ref": "https://advanced-harness.local/eval/schemas/run-manifest.schema.json"
    },
    "repeatability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeatCount",
        "allRepeatable",
        "executedScenarios",
        "totalScenarios",
        "scenarioSummaries"
      ],
      "properties": {
        "repeatCount": { "type": "integer", "minimum": 1 },
        "allRepeatable": { "type": "boolean" },
        "executedScenarios": { "type": "integer", "minimum": 0 },
        "totalScenarios": { "type": "integer", "minimum": 1 },
        "scenarioSummaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenarioId",
              "scenarioVersion",
              "bound",
              "outcomes",
              "repeatable",
              "differenceCount"
            ],
            "properties": {
              "scenarioId": { "type": "string", "pattern": "^EDD-(DEV|VAL)-[0-9]{3,}$" },
              "scenarioVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
              "bound": { "type": "boolean" },
              "outcomes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": ["pass", "fail", "skipped", "inconclusive", "infrastructure_error"]
                }
              },
              "repeatable": { "type": "boolean" },
              "differenceCount": { "type": "integer", "minimum": 0 },
              "repeatDurationsMs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://advanced-harness.local/eval/schemas/result.schema.json"
      }
    },
    "metricObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "notObserved"],
      "properties": {
        "observed": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/coreMetricName" }
        },
        "notObserved": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/coreMetricName" }
        }
      }
    },
    "supplementaryMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementCoverage",
        "reworkCycles",
        "planDriftCount",
        "contextReconstructionCount",
        "evidenceQuality",
        "tokenUsage",
        "plannedApprovalGates"
      ],
      "properties": {
        "requirementCoverage": {
          "oneOf": [
            { "$ref": "#/$defs/notMeasuredMetric" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "met", "total"],
              "properties": {
                "status": { "const": "measured" },
                "met": { "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 1 },
                "note": { "type": "string", "pattern": "\\S" }
              }
            }
          ]
        },
        "reworkCycles": { "$ref": "#/$defs/countMetric" },
        "planDriftCount": { "$ref": "#/$defs/countMetric" },
        "contextReconstructionCount": { "$ref": "#/$defs/countMetric" },
        "evidenceQuality": {
          "oneOf": [
            { "$ref": "#/$defs/notMeasuredMetric" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "summary",
                "checksReRun",
                "checksJudgedFromEvidence",
                "missingArtifacts"
              ],
              "properties": {
                "status": { "const": "measured" },
                "summary": { "type": "string", "pattern": "\\S" },
                "checksReRun": { "type": "integer", "minimum": 0 },
                "checksJudgedFromEvidence": { "type": "integer", "minimum": 0 },
                "missingArtifacts": { "type": "integer", "minimum": 0 },
                "note": { "type": "string", "pattern": "\\S" }
              }
            }
          ]
        },
        "tokenUsage": {
          "oneOf": [
            { "$ref": "#/$defs/notMeasuredMetric" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "inputTokens", "outputTokens"],
              "properties": {
                "status": { "const": "measured" },
                "inputTokens": { "type": "integer", "minimum": 0 },
                "outputTokens": { "type": "integer", "minimum": 0 },
                "cachedTokens": { "type": "integer", "minimum": 0 },
                "estimatedCostUsd": { "type": "number", "minimum": 0 },
                "pricingBasis": { "type": "string", "pattern": "\\S" },
                "note": { "type": "string", "pattern": "\\S" }
              }
            }
          ]
        },
        "plannedApprovalGates": { "$ref": "#/$defs/countMetric" }
      }
    },
    "journeyBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "commit",
        "opencodeVersion",
        "networkEnforcement",
        "ciRunId",
        "artifactId",
        "recordedAt",
        "journeys"
      ],
      "properties": {
        "source": { "type": "string", "pattern": "\\S" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "opencodeVersion": { "type": "string", "pattern": "\\S" },
        "networkEnforcement": { "type": "string", "enum": ["netns", "none"] },
        "ciRunId": { "type": "string", "pattern": "\\S" },
        "artifactId": { "type": "string", "pattern": "\\S" },
        "recordedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "journeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "journey",
              "testOutcome",
              "recordOutcome",
              "handoffCount",
              "roleTransitions",
              "skillsInvoked",
              "toolCallCount",
              "violationCount"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "\\S" },
              "journey": { "type": "string", "pattern": "\\S" },
              "testOutcome": { "type": "string", "enum": ["pass", "fail", "todo"] },
              "recordOutcome": { "type": "string", "enum": ["pass", "fail"] },
              "handoffCount": { "type": "integer", "minimum": 0 },
              "roleTransitions": {
                "type": "array",
                "items": { "type": "string", "pattern": "\\S" }
              },
              "skillsInvoked": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["skillId", "loaded"],
                  "properties": {
                    "skillId": { "type": "string", "pattern": "\\S" },
                    "loaded": { "type": "boolean" }
                  }
                }
              },
              "toolCallCount": { "type": "integer", "minimum": 0 },
              "violationCount": { "type": "integer", "minimum": 0 },
              "repeatsByteIdentical": { "type": "boolean" },
              "notes": { "type": "string", "pattern": "\\S" }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "\\S" }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "reason", "approvedBy"],
        "properties": {
          "scope": { "type": "string", "pattern": "\\S" },
          "reason": { "type": "string", "pattern": "\\S" },
          "approvedBy": { "type": "string", "pattern": "\\S" },
          "reference": { "type": "string", "pattern": "\\S" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "recordKind": { "const": "candidate" } },
        "required": ["recordKind"]
      },
      "then": { "required": ["baselineRef"] }
    }
  ],
  "$defs": {
    "capabilityStatus": {
      "type": "string",
      "enum": ["enforced", "advisory", "unsupported", "unverified"]
    },
    "coreMetricName": {
      "type": "string",
      "enum": [
        "handoffCount",
        "roleTransitions",
        "skillsInvoked",
        "humanInterventions",
        "permissionAmbiguities",
        "reviewDetectedDefects",
        "escapedDefects",
        "tokenCostUsd",
        "durationMs"
      ]
    },
    "notMeasuredMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": { "type": "string", "enum": ["not-observed", "unknown"] },
        "note": { "type": "string", "pattern": "\\S" }
      }
    },
    "countMetric": {
      "oneOf": [
        { "$ref": "#/$defs/notMeasuredMetric" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "count"],
          "properties": {
            "status": { "const": "measured" },
            "count": { "type": "integer", "minimum": 0 },
            "note": { "type": "string", "pattern": "\\S" }
          }
        }
      ]
    }
  }
}
