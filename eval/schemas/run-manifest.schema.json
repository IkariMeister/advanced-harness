{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advanced-harness.local/eval/schemas/run-manifest.schema.json",
  "title": "EDD v1 Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "mode",
    "host",
    "roleSetup",
    "modelConfig",
    "rubricId",
    "rubricVersion",
    "isolation",
    "scenarioIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": { "type": "string", "pattern": "\\S" },
    "createdAt": { "type": "string", "pattern": "\\S" },
    "mode": {
      "type": "string",
      "enum": ["deterministic", "live"]
    },
    "host": {
      "type": "string",
      "enum": ["opencode", "claude-code", "antigravity", "codex", "cursor"]
    },
    "roleSetup": {
      "type": "string",
      "enum": ["eight-role", "engineer-pilot", "operations-pilot"]
    },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "fixtureLoopbackOnly"],
      "properties": {
        "provider": { "type": "string", "pattern": "\\S" },
        "fixtureLoopbackOnly": { "type": "boolean" },
        "roleModels": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "\\S" }
        }
      }
    },
    "rubricId": { "type": "string", "pattern": "\\S" },
    "rubricVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tempRepo", "isolatedConfig", "networkAllowed"],
      "properties": {
        "tempRepo": { "type": "boolean" },
        "isolatedConfig": { "type": "boolean" },
        "networkAllowed": { "type": "boolean" }
      }
    },
    "scenarioIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^EDD-(DEV|VAL)-[0-9]{3,}$"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "deterministic" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "modelConfig": {
            "properties": {
              "fixtureLoopbackOnly": { "const": true }
            }
          },
          "isolation": {
            "properties": {
              "networkAllowed": { "const": false }
            }
          }
        }
      }
    }
  ]
}
