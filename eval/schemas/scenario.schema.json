{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advanced-harness.local/eval/schemas/scenario.schema.json",
  "title": "EDD v1 Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "set",
    "title",
    "description",
    "polarity",
    "category",
    "severity",
    "targets",
    "preconditions",
    "stimulus",
    "expectedOutcome",
    "evidence",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^EDD-(DEV|VAL)-[0-9]{3,}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "set": {
      "type": "string",
      "enum": ["development", "validation"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "polarity": {
      "type": "string",
      "enum": ["positive", "negative"]
    },
    "category": {
      "type": "string",
      "enum": ["approval", "permissions", "scope", "tool-errors", "recovery", "incident"]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "prompts", "skills", "workflows", "adapters"],
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "lead",
              "operator",
              "external",
              "researcher",
              "planner",
              "implementer",
              "reviewer",
              "qa",
              "engineer",
              "operations"
            ]
          }
        },
        "prompts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "workflows": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["opencode", "claude-code", "antigravity", "codex", "cursor"]
          }
        }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoState", "host", "roleSetup", "constraints"],
      "properties": {
        "repoState": { "type": "string", "minLength": 1 },
        "host": {
          "type": "string",
          "enum": ["opencode", "claude-code", "antigravity", "codex", "cursor", "any"]
        },
        "roleSetup": {
          "type": "string",
          "enum": ["eight-role", "engineer-pilot", "operations-pilot", "any"]
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stimulus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userPrompt", "events"],
      "properties": {
        "userPrompt": { "type": "string", "minLength": 1 },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expectedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions", "observableFinalState"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "inconclusive"]
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredSkills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedRoleTransitions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observableFinalState": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "requiredArtifacts"],
      "properties": {
        "format": {
          "const": "evidence-collection-v1"
        },
        "requiredArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sanitized", "sourceSummary"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["synthetic", "sanitized-incident"]
        },
        "sanitized": { "type": "boolean" },
        "sourceSummary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
