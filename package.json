{
  "name": "advanced-harness",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "smoke": "node --test --test-concurrency=1 smoke/*.smoke.ts",
    "typecheck": "tsc --noEmit",
    "harness:install": "node scripts/install-native-harness.ts",
    "harness:uninstall": "node scripts/uninstall-native-harness.ts",
    "harness:doctor": "node scripts/diagnose-native-harness.ts",
    "harness:update": "node scripts/update-native-harness.ts",
    "harness:setup": "node scripts/setup-native-project.ts",
    "harness:integrations": "node scripts/configure-integrations.ts",
    "harness:pr-feedback-permissions": "node scripts/add-pr-feedback-permissions.ts",
    "harness:deploy-prompts": "node scripts/deploy-native-prompts.ts"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
